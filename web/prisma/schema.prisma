generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// MULTI-TENANT (ver MULTI-TENANT.md)
// Cada tabla de negocio lleva `orgId`. Su DEFAULT lo pone Postgres leyendo el
// tenant del contexto de la transacción (`app.current_org`), por eso es opcional
// en el código: los `.create()` existentes NO cambian. RLS filtra las lecturas.
// El literal del default se repite por modelo:
//   @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint"))
// ─────────────────────────────────────────────────────────────────────────────

enum RolUsuario {
  admin
  agente

  @@map("rol_usuario")
}

enum TipoEtapa {
  normal
  ganado
  perdido

  @@map("tipo_etapa")
}

enum EstadoOport {
  abierto
  ganado
  perdido

  @@map("estado_oport")
}

enum FuenteContacto {
  whatsapp
  manual
  meta_ads
  web
  otro

  @@map("fuente_contacto")
}

enum EstadoConv {
  abierta
  pendiente
  cerrada

  @@map("estado_conv")
}

enum DireccionMsg {
  entrante
  saliente

  @@map("direccion_msg")
}

enum TipoMsg {
  texto
  imagen
  audio
  video
  documento
  ubicacion
  plantilla

  @@map("tipo_msg")
}

enum StatusMsg {
  pendiente
  enviado
  entregado
  leido
  fallido

  @@map("status_msg")
}

enum ProveedorCanal {
  cloud_api

  @@map("proveedor_canal")
}

enum EstadoCanal {
  conectado
  desconectado

  @@map("estado_canal")
}

enum TipoEvento {
  creada
  etapa_cambio
  ganada
  perdida
  nota
  tarea
  mensaje
  asignacion

  @@map("tipo_evento")
}

enum EntidadCampoPersonalizado {
  contacto
  oportunidad

  @@map("entidad_campo_personalizado")
}

enum TipoCampoPersonalizado {
  texto
  numero
  fecha
  opcion
  si_no

  @@map("tipo_campo_personalizado")
}

enum EstadoCita {
  programada
  confirmada
  en_sala
  completada
  cancelada
  no_asistio

  @@map("estado_cita")
}

enum EstadoVehiculo {
  disponible
  reservado
  vendido
  taller

  @@map("estado_vehiculo")
}

/// Tenant. NO lleva orgId ni RLS: es la tabla raíz del multi-tenant.
model Org {
  id        BigInt   @id @default(autoincrement())
  nombre    String
  slug      String   @unique // subdominio: cliente.tucrm.com
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("orgs")
}

model Usuario {
  id           BigInt     @id @default(autoincrement())
  orgId        BigInt     @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  nombre       String
  email        String
  passwordHash String     @map("password_hash")
  rol          RolUsuario @default(agente)
  puesto       String     @default("Agente")
  avatarUrl    String?    @map("avatar_url")
  activo       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at")

  contactos          Contacto[]
  oportunidades      Oportunidad[]
  conversaciones     Conversacion[]
  mensajes           Mensaje[]
  notas              Nota[]
  tareas             Tarea[]
  eventos            Evento[]
  citas              Cita[]
  evoluciones        EvolucionClinica[]
  ventasCreadas      Venta[]                   @relation("VentaCreadoPor")
  movimientos        MovimientoInventario[]    @relation("MovimientoUsuario")
  comprasCreadas     Compra[]                  @relation("CompraCreadoPor")
  expedientesLegales ExpedienteLegal[]         @relation("ExpedienteResponsable")
  registrosLegales   RegistroExpedienteLegal[] @relation("RegistroLegalUsuario")
  asesoriasLegales   AsesoriaLegal[]           @relation("AsesoriaAbogado")
  movimientosLegales MovimientoLegal[]         @relation("MovimientoLegalUsuario")
  operacionesLegales RegistroOperacionLegal[]  @relation("OperacionLegalUsuario")

  @@unique([orgId, email])
  @@index([orgId])
  @@map("usuarios")
}

model Embudo {
  id          BigInt   @id @default(autoincrement())
  orgId       BigInt   @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  nombre      String
  descripcion String?
  color       String   @default("#1E3A5F")
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  etapas        Etapa[]
  oportunidades Oportunidad[]

  @@index([orgId])
  @@map("embudos")
}

model Etapa {
  id        BigInt    @id @default(autoincrement())
  orgId     BigInt    @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  embudoId  BigInt    @map("embudo_id")
  nombre    String
  color     String    @default("#94A3B8")
  orden     Int       @default(0)
  tipo      TipoEtapa @default(normal)
  createdAt DateTime  @default(now()) @map("created_at")

  embudo        Embudo        @relation(fields: [embudoId], references: [id], onDelete: Cascade)
  oportunidades Oportunidad[]

  @@index([embudoId, orden])
  @@index([orgId])
  @@map("etapas")
}

model Contacto {
  id            BigInt         @id @default(autoincrement())
  orgId         BigInt         @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  nombre        String
  telefono      String?
  email         String?
  empresa       String?
  avatarUrl     String?        @map("avatar_url")
  fuente        FuenteContacto @default(manual)
  notas         String?
  responsableId BigInt?        @map("responsable_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at")

  esPersonal     Boolean @default(false) @map("es_personal")
  optOutDifusion Boolean @default(false) @map("opt_out_difusion") // excluido de difusiones masivas
  campos         Json    @default("{}")

  responsable        Usuario?            @relation(fields: [responsableId], references: [id], onDelete: SetNull)
  etiquetas          ContactoEtiqueta[]
  oportunidades      Oportunidad[]
  conversaciones     Conversacion[]
  citas              Cita[]
  expediente         ExpedientePaciente?
  ventas             Venta[]
  expedientesLegales ExpedienteLegal[]
  asesoriasLegales   AsesoriaLegal[]
  movimientosLegales MovimientoLegal[]

  @@unique([orgId, telefono])
  @@index([responsableId])
  @@index([orgId])
  @@map("contactos")
}

model Etiqueta {
  id     BigInt @id @default(autoincrement())
  orgId  BigInt @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  nombre String
  color  String @default("#B45309")

  contactos ContactoEtiqueta[]

  @@unique([orgId, nombre])
  @@index([orgId])
  @@map("etiquetas")
}

model ContactoEtiqueta {
  orgId      BigInt @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  contactoId BigInt @map("contacto_id")
  etiquetaId BigInt @map("etiqueta_id")

  contacto Contacto @relation(fields: [contactoId], references: [id], onDelete: Cascade)
  etiqueta Etiqueta @relation(fields: [etiquetaId], references: [id], onDelete: Cascade)

  @@id([contactoId, etiquetaId])
  @@index([orgId])
  @@map("contacto_etiquetas")
}

model Oportunidad {
  id                  BigInt      @id @default(autoincrement())
  orgId               BigInt      @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  contactoId          BigInt      @map("contacto_id")
  embudoId            BigInt      @map("embudo_id")
  etapaId             BigInt      @map("etapa_id")
  titulo              String
  valor               Decimal     @default(0) @db.Decimal(12, 2)
  moneda              String      @default("MXN")
  responsableId       BigInt?     @map("responsable_id")
  orden               Int         @default(0)
  estado              EstadoOport @default(abierto)
  motivoPerdida       String?     @map("motivo_perdida")
  fechaCierreEstimada DateTime?   @map("fecha_cierre_estimada") @db.Date
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @default(now()) @updatedAt @map("updated_at")
  closedAt            DateTime?   @map("closed_at")
  campos              Json        @default("{}")

  contacto    Contacto @relation(fields: [contactoId], references: [id], onDelete: Cascade)
  embudo      Embudo   @relation(fields: [embudoId], references: [id], onDelete: Cascade)
  etapa       Etapa    @relation(fields: [etapaId], references: [id], onDelete: Restrict)
  responsable Usuario? @relation(fields: [responsableId], references: [id], onDelete: SetNull)
  notas       Nota[]
  tareas      Tarea[]
  eventos     Evento[]

  @@index([etapaId, orden])
  @@index([embudoId])
  @@index([contactoId])
  @@index([orgId])
  @@map("oportunidades")
}

model CanalWhatsapp {
  id        BigInt         @id @default(autoincrement())
  orgId     BigInt         @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  nombre    String
  proveedor ProveedorCanal @default(cloud_api)
  telefono  String?
  instancia String?
  estado    EstadoCanal    @default(desconectado)
  config    Json           @default("{}")
  activo    Boolean        @default(true)
  createdAt DateTime       @default(now()) @map("created_at")

  conversaciones Conversacion[]
  bots           Bot[]
  grupos         Grupo[]

  @@index([orgId])
  @@map("canales_whatsapp")
}

// Grupos de WhatsApp: bandeja aparte, NO son leads (no entran al embudo/CSAT/contactos).
model Grupo {
  id              BigInt    @id @default(autoincrement())
  orgId           BigInt    @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  canalId         BigInt?   @map("canal_id")
  jid             String
  nombre          String
  noLeidos        Int       @default(0) @map("no_leidos")
  ultimoMensajeAt DateTime? @map("ultimo_mensaje_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  canal    CanalWhatsapp? @relation(fields: [canalId], references: [id], onDelete: SetNull)
  mensajes MensajeGrupo[]

  @@unique([orgId, jid])
  @@index([orgId])
  @@map("grupos")
}

model MensajeGrupo {
  id           BigInt       @id @default(autoincrement())
  orgId        BigInt       @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  grupoId      BigInt       @map("grupo_id")
  direccion    DireccionMsg
  tipo         TipoMsg      @default(texto)
  contenido    String?
  mediaUrl     String?      @map("media_url")
  mediaMime    String?      @map("media_mime")
  remitente    String? // nombre de quien escribió en el grupo
  remitenteTel String?      @map("remitente_tel")
  status       StatusMsg    @default(enviado)
  waMessageId  String?      @unique @map("wa_message_id")
  enviadoPor   BigInt?      @map("enviado_por")
  timestamp    DateTime     @default(now())
  createdAt    DateTime     @default(now()) @map("created_at")

  grupo Grupo @relation(fields: [grupoId], references: [id], onDelete: Cascade)

  @@index([grupoId, timestamp])
  @@index([orgId])
  @@map("mensajes_grupo")
}

// Bot nativo: webhook saliente (CRM->n8n) + token para responder (n8n->CRM).
model Bot {
  id         BigInt   @id @default(autoincrement())
  orgId      BigInt   @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  nombre     String
  webhookUrl String   @map("webhook_url") // n8n: el CRM le manda los mensajes entrantes
  apiToken   String   @unique @map("api_token") // n8n: autentica de vuelta con header api_access_token
  canalId    BigInt?  @map("canal_id") // null = aplica a todos los canales
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  canal CanalWhatsapp? @relation(fields: [canalId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@map("bots")
}

model Conversacion {
  id              BigInt     @id @default(autoincrement())
  orgId           BigInt     @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  contactoId      BigInt     @map("contacto_id")
  canalId         BigInt?    @map("canal_id")
  estado          EstadoConv @default(abierta)
  responsableId   BigInt?    @map("responsable_id")
  noLeidos        Int        @default(0) @map("no_leidos")
  botActivo       Boolean    @default(true) @map("bot_activo")
  etiquetas       String[]   @default([])
  csatScore       Int?       @map("csat_score")
  csatEnviadoAt   DateTime?  @map("csat_enviado_at")
  avisoFueraAt    DateTime?  @map("aviso_fuera_at")
  ultimoMensajeAt DateTime?  @map("ultimo_mensaje_at")
  /// Chat fijado (va primero en la bandeja). Null = no fijado.
  fijadoAt        DateTime?  @map("fijado_at")
  createdAt       DateTime   @default(now()) @map("created_at")

  contacto    Contacto            @relation(fields: [contactoId], references: [id], onDelete: Cascade)
  canal       CanalWhatsapp?      @relation(fields: [canalId], references: [id], onDelete: SetNull)
  responsable Usuario?            @relation(fields: [responsableId], references: [id], onDelete: SetNull)
  mensajes    Mensaje[]
  programados MensajeProgramado[]
  citas       Cita[]

  @@unique([contactoId, canalId])
  @@index([ultimoMensajeAt])
  @@index([orgId])
  @@map("conversaciones")
}

/// Mensajes de WhatsApp programados para enviarse después (los dispara el cron).
model MensajeProgramado {
  id             BigInt   @id @default(autoincrement())
  orgId          BigInt   @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  conversacionId BigInt   @map("conversacion_id")
  contenido      String
  enviarAt       DateTime @map("enviar_at")
  estado         String   @default("pendiente") // pendiente | enviado | fallido | cancelado
  creadoPor      BigInt?  @map("creado_por")
  createdAt      DateTime @default(now()) @map("created_at")

  conversacion Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)

  @@index([estado, enviarAt])
  @@index([orgId])
  @@map("mensajes_programados")
}

/// Suscripciones Web Push (una por navegador/dispositivo de cada usuario).
model PushSuscripcion {
  id        BigInt   @id @default(autoincrement())
  orgId     BigInt   @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  usuarioId BigInt?  @map("usuario_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orgId])
  @@map("push_suscripciones")
}

model Mensaje {
  id             BigInt       @id @default(autoincrement())
  orgId          BigInt       @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  conversacionId BigInt       @map("conversacion_id")
  direccion      DireccionMsg
  tipo           TipoMsg      @default(texto)
  contenido      String?
  mediaUrl       String?      @map("media_url")
  mediaMime      String?      @map("media_mime")
  interna        Boolean      @default(false)
  esDifusion     Boolean      @default(false) @map("es_difusion")
  status         StatusMsg    @default(enviado)
  errorDetalle   String?      @map("error_detalle")
  waMessageId    String?      @unique @map("wa_message_id")
  enviadoPor     BigInt?      @map("enviado_por")
  timestamp      DateTime     @default(now())
  createdAt      DateTime     @default(now()) @map("created_at")

  conversacion Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  usuario      Usuario?     @relation(fields: [enviadoPor], references: [id], onDelete: SetNull)

  @@index([conversacionId, timestamp])
  @@index([orgId])
  @@map("mensajes")
}

model PlantillaMensaje {
  id        BigInt   @id @default(autoincrement())
  orgId     BigInt   @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  nombre    String
  contenido String
  categoria String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orgId])
  @@map("plantillas_mensaje")
}

model Nota {
  id            BigInt   @id @default(autoincrement())
  orgId         BigInt   @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  oportunidadId BigInt   @map("oportunidad_id")
  usuarioId     BigInt?  @map("usuario_id")
  contenido     String
  createdAt     DateTime @default(now()) @map("created_at")

  oportunidad Oportunidad @relation(fields: [oportunidadId], references: [id], onDelete: Cascade)
  usuario     Usuario?    @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@map("notas")
}

model Tarea {
  id            BigInt    @id @default(autoincrement())
  orgId         BigInt    @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  oportunidadId BigInt?   @map("oportunidad_id")
  responsableId BigInt?   @map("responsable_id")
  titulo        String
  descripcion   String?
  venceAt       DateTime? @map("vence_at")
  completada    Boolean   @default(false)
  completadaAt  DateTime? @map("completada_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  oportunidad Oportunidad? @relation(fields: [oportunidadId], references: [id], onDelete: Cascade)
  responsable Usuario?     @relation(fields: [responsableId], references: [id], onDelete: SetNull)

  @@index([responsableId, venceAt])
  @@index([orgId])
  @@map("tareas")
}

// Una fila de ajustes POR org (ya no es única global).
model Ajustes {
  id                 BigInt   @id @default(autoincrement())
  orgId              BigInt   @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  autoAsignar        Boolean  @default(false) @map("auto_asignar")
  bienvenidaActiva   Boolean  @default(false) @map("bienvenida_activa")
  bienvenidaTexto    String?  @map("bienvenida_texto")
  crearLeadAuto      Boolean  @default(true) @map("crear_lead_auto")
  // CSAT
  csatActivo         Boolean  @default(false) @map("csat_activo")
  csatTexto          String?  @map("csat_texto")
  // Horario de atención
  horarioActivo      Boolean  @default(false) @map("horario_activo")
  horarioInicio      String?  @map("horario_inicio") // "09:00"
  horarioFin         String?  @map("horario_fin") // "18:00"
  horarioDias        String?  @map("horario_dias") // "1,2,3,4,5" (1=lunes)
  fueraHorarioTexto  String?  @map("fuera_horario_texto")
  // Auto-resolver
  autoResolverActivo Boolean  @default(false) @map("auto_resolver_activo")
  autoResolverHoras  Int      @default(24) @map("auto_resolver_horas")
  // IA
  nombreNegocio      String?  @map("nombre_negocio")
  iaPromptSistema    String?  @map("ia_prompt_sistema")
  marcaNombre        String?  @map("marca_nombre")
  marcaLogo          String?  @map("marca_logo")
  marcaColorPrimario String?  @map("marca_color_primario")
  marcaColorAcento   String?  @map("marca_color_acento")
  marcaPreset        String?  @map("marca_preset")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([orgId])
  @@map("ajustes")
}

model ModuloOrg {
  id        BigInt   @id @default(autoincrement())
  orgId     BigInt   @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  clave     String
  activo    Boolean  @default(false)
  config    Json     @default("{}")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([orgId, clave])
  @@index([orgId])
  @@map("modulos_org")
}

model CampoPersonalizado {
  id          BigInt                    @id @default(autoincrement())
  orgId       BigInt                    @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  entidad     EntidadCampoPersonalizado
  clave       String
  etiqueta    String
  tipo        TipoCampoPersonalizado
  opciones    Json                      @default("[]")
  obligatorio Boolean                   @default(false)
  orden       Int                       @default(0)
  activo      Boolean                   @default(true)

  @@unique([orgId, entidad, clave])
  @@index([orgId, entidad, orden])
  @@map("campos_personalizados")
}

model Cita {
  id                    BigInt     @id @default(autoincrement())
  orgId                 BigInt     @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  contactoId            BigInt     @map("contacto_id")
  conversacionId        BigInt?    @map("conversacion_id")
  responsableId         BigInt?    @map("responsable_id")
  doctorId              BigInt?    @map("doctor_id")
  inicio                DateTime
  fin                   DateTime
  titulo                String
  notas                 String?
  estado                EstadoCita @default(programada)
  recordatorioEnviadoAt DateTime?  @map("recordatorio_enviado_at")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @default(now()) @updatedAt @map("updated_at")

  contacto     Contacto           @relation(fields: [contactoId], references: [id], onDelete: Cascade)
  conversacion Conversacion?      @relation(fields: [conversacionId], references: [id], onDelete: SetNull)
  responsable  Usuario?           @relation(fields: [responsableId], references: [id], onDelete: SetNull)
  doctor       Doctor?            @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  evoluciones  EvolucionClinica[]

  @@index([orgId, inicio])
  @@index([contactoId])
  @@index([doctorId])
  @@map("citas")
}

model Doctor {
  id           BigInt   @id @default(autoincrement())
  orgId        BigInt   @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  nombre       String
  especialidad String?
  cedula       String?
  color        String   @default("#0EA5E9")
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  citas       Cita[]
  evoluciones EvolucionClinica[]

  @@unique([orgId, nombre])
  @@index([orgId, activo])
  @@map("doctores")
}

model ExpedientePaciente {
  id              BigInt    @id @default(autoincrement())
  orgId           BigInt    @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  contactoId      BigInt    @unique @map("contacto_id")
  fechaNacimiento DateTime? @map("fecha_nacimiento") @db.Date
  sexo            String?
  alergias        String?
