# Variables del docker-compose (raíz de AmbarCRM)

# ---- Postgres ----
# POSTGRES_* = rol dueño (solo migra/init). La app NO usa este rol.
POSTGRES_USER=ambarcrm
POSTGRES_PASSWORD=CAMBIA_ESTA_CLAVE
POSTGRES_DB=ambarcrm
# Rol con el que corre la app (sometido a RLS). Usa solo letras/números (va en DATABASE_URL).
CRM_APP_PASSWORD=CAMBIA_ESTA_CLAVE_APP

# ---- App / Auth ----
NEXTAUTH_URL=https://crm.tudominio.com
NEXTAUTH_SECRET=genera_uno_con_openssl_rand_base64_32

# ---- Recuperación de contraseña por correo (opcional; requiere todos los campos) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AmbarCRM <no-reply@ambarrojostudios.cloud>

# ---- API para crons y bots n8n ----
WA_API_KEY=clave_larga_para_n8n

# ---- Meta WhatsApp Cloud API / Tech Provider ----
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=genera_una_clave_larga_aleatoria
META_GRAPH_VERSION=v26.0
META_HUMAN_AGENT_APROBADO=false
# Verificación de webhooks de Messenger e Instagram; el mismo valor va en el panel de Meta.
MESSENGER_VERIFY_TOKEN=
# IDs de organización (separados por coma) que ven Messenger e Instagram en Configuración. Vacío = nadie. Úsalo solo para la org del revisor de Meta.
META_CANALES_REVISION_ORGS=
# Opcional: config_id de Facebook Login para empresas (tipo "User access token"). Vacío = el diálogo usa scope.
META_MESSENGER_CONFIG_ID=
META_INSTAGRAM_CONFIG_ID=
# Genera con: openssl rand -base64 32
META_TOKEN_ENCRYPTION_KEY=
# Los NEXT_PUBLIC_* se necesitan también durante el build de Next.js.
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=
NEXT_PUBLIC_META_GRAPH_VERSION=v26.0

# ---- Datos legales públicos para App Review ----
LEGAL_BUSINESS_NAME=Ámbar Rojo Studios
PRIVACY_EMAIL=

# ---- IA (sugerencias de respuesta en el chat) ----
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---- Notificaciones push (opcional; sin claves la app corre igual, solo sin push) ----
# Genera el par con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---- Admin inicial (se crea solo al arrancar; si ADMIN_PASSWORD va vacío no se crea) ----
ADMIN_NOMBRE=Admin
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=
# ---- Pagos en línea (Mercado Pago Checkout Pro) ----
PAGOS_PROVEEDOR=mercado_pago
PAGOS_ORG_PILOTO=
# Genera una clave de 32 bytes en Base64. No la cambies sin migrar los tokens cifrados.
PAGOS_TOKEN_ENCRYPTION_KEY=
PAGOS_BASE_URL=http://localhost:3000
PAGOS_PERMITIR_MOCK=0
PAGOS_MOCK_SECRET=
PAGOS_PERMITIR_CREDENCIALES_MANUALES=0
# ---- Google Calendar bidireccional (Fase 3) ----
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
CALENDARIO_OAUTH_REDIRECT_BASE=http://localhost:3000/api/calendario/oauth/callback
CALENDARIO_PERMITIR_MOCK=0
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_REDIRECT_URI=http://localhost:3000/api/pagos/oauth/callback
# Secreto de firma de la aplicación de Mercado Pago, compartido por sus webhooks.
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_SANDBOX=1
# Envía test_token=true al crear la credencial OAuth. Si se omite, hereda SANDBOX.
MERCADOPAGO_TEST_TOKEN=1
# Debe coincidir con el ajuste PKCE de la aplicación en Mercado Pago.
MERCADOPAGO_PKCE=0
# Obsoleto: solo fallback transitorio para PAGOS_ORG_PILOTO; OAuth es el flujo normal.
MERCADOPAGO_ACCESS_TOKEN=
# Llave secreta de la plataforma Stripe; admite sk_test_ o sk_live_. Nunca se guarda en la BD.
STRIPE_SECRET_KEY=
# País de la plataforma y de las cuentas Standard creadas por Connect (ISO 3166-1 alpha-2).
STRIPE_PAIS=MX
# Secreto whsec_ del webhook de Connect configurado en Stripe.
STRIPE_WEBHOOK_SECRET=

# ---- CFDI 4.0 (Fase 2A.1: mock, sin PAC real) ----
# Fase 2A.1 solo soporta mock. Facturama/SW Sapien quedan para Fase 2B.
CFDI_PROVEEDOR=mock
# Solo para entornos controlados. En producción el mock se rechaza.
CFDI_PERMITIR_MOCK=0
# Credenciales del PAC. Nunca se guardan en la BD ni se registran en logs.
FACTURAMA_USUARIO=
FACTURAMA_PASSWORD=
FACTURAMA_URL=
