generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// MULTI-TENANT (ver MULTI-TENANT.md)
// Cada tabla de negocio lleva `orgId`. Su DEFAULT lo pone Postgres leyendo el
// tenant del contexto de la transacción (`app.current_org`), por eso es opcional
// en el código: los `.create()` existentes NO cambian. RLS filtra las lecturas.
// El literal del default se repite por modelo:
//   @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint"))
// ─────────────────────────────────────────────────────────────────────────────

enum RolUsuario {
  admin
  agente

  @@map("rol_usuario")
}

enum TipoEtapa {
  normal
  ganado
  perdido

  @@map("tipo_etapa")
}

enum EstadoOport {
  abierto
  ganado
  perdido

  @@map("estado_oport")
}

enum FuenteContacto {
  whatsapp
  manual
  meta_ads
  web
  otro

  @@map("fuente_contacto")
}

enum EstadoConv {
  abierta
  pendiente
  cerrada

  @@map("estado_conv")
}

enum DireccionMsg {
  entrante
  saliente

  @@map("direccion_msg")
}

enum TipoMsg {
  texto
  imagen
  audio
  video
  documento
  ubicacion
  plantilla

  @@map("tipo_msg")
}

enum StatusMsg {
  pendiente
  enviado
  entregado
  leido
  fallido

  @@map("status_msg")
}

enum ProveedorCanal {
  cloud_api

  @@map("proveedor_canal")
}

enum EstadoCanal {
  conectado
  desconectado

  @@map("estado_canal")
}

enum TipoEvento {
  creada
  etapa_cambio
  ganada
  perdida
  nota
  tarea
  mensaje
  asignacion

  @@map("tipo_evento")
}

enum EntidadCampoPersonalizado {
  contacto
  oportunidad

  @@map("entidad_campo_personalizado")
}

enum TipoCampoPersonalizado {
  texto
  numero
  fecha
  opcion
  si_no

  @@map("tipo_campo_personalizado")
}

enum EstadoCita {
  programada
  confirmada
  en_sala
  completada
  cancelada
  no_asistio

  @@map("estado_cita")
}

enum EstadoVehiculo {
  disponible
  reservado
  vendido
  taller

  @@map("estado_vehiculo")
}

/// Tenant. NO lleva orgId ni RLS: es la tabla raíz del multi-tenant.
model Org {
  id        BigInt   @id @default(autoincrement())
  nombre    String
  slug      String   @unique // subdominio: cliente.tucrm.com
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("orgs")
}

model Usuario {
  id           BigInt     @id @default(autoincrement())
  orgId        BigInt     @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  nombre       String
  email        String
  passwordHash String     @map("password_hash")
  rol          RolUsuario @default(agente)
  puesto       String     @default("Agente")
  avatarUrl    String?    @map("avatar_url")
  activo       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at")

  contactos           Contacto[]
  oportunidades       Oportunidad[]
  conversaciones      Conversacion[]
  mensajes            Mensaje[]
  notas               Nota[]
  tareas              Tarea[]
  eventos             Evento[]
  citas               Cita[]
  evoluciones         EvolucionClinica[]
  ventasCreadas       Venta[]                   @relation("VentaCreadoPor")
  movimientos         MovimientoInventario[]    @relation("MovimientoUsuario")
  comprasCreadas      Compra[]                  @relation("CompraCreadoPor")
  turnosCaja          TurnoCaja[]
  movimientosCaja     MovimientoCaja[]          @relation("MovimientoCajaUsuario")
  devolucionesCaja    DevolucionVenta[]
  apartadosCreados    Apartado[]
  abonosApartado      AbonoApartado[]
  movimientosCuenta   MovimientoCuentaCliente[]
  cotizacionesCreadas Cotizacion[]              @relation("CotizacionCreadaPor")
  expedientesLegales  ExpedienteLegal[]         @relation("ExpedienteResponsable")
  registrosLegales    RegistroExpedienteLegal[] @relation("RegistroLegalUsuario")
  asesoriasLegales    AsesoriaLegal[]           @relation("AsesoriaAbogado")
  movimientosLegales  MovimientoLegal[]         @relation("MovimientoLegalUsuario")
  operacionesLegales  RegistroOperacionLegal[]  @relation("OperacionLegalUsuario")

  @@unique([orgId, email])
  @@index([orgId])
  @@map("usuarios")
}

model Embudo {
  id          BigInt   @id @default(autoincrement())
  orgId       BigInt   @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  nombre      String
  descripcion String?
  color       String   @default("#1E3A5F")
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  etapas        Etapa[]
  oportunidades Oportunidad[]

  @@index([orgId])
  @@map("embudos")
}

model Etapa {
  id        BigInt    @id @default(autoincrement())
  orgId     BigInt    @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  embudoId  BigInt    @map("embudo_id")
  nombre    String
  color     String    @default("#94A3B8")
  orden     Int       @default(0)
  tipo      TipoEtapa @default(normal)
  createdAt DateTime  @default(now()) @map("created_at")

  embudo        Embudo        @relation(fields: [embudoId], references: [id], onDelete: Cascade)
  oportunidades Oportunidad[]

  @@index([embudoId, orden])
  @@index([orgId])
  @@map("etapas")
}

model Contacto {
  id            BigInt         @id @default(autoincrement())
  orgId         BigInt         @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  nombre        String
  telefono      String?
  email         String?
  empresa       String?
  avatarUrl     String?        @map("avatar_url")
  fuente        FuenteContacto @default(manual)
  notas         String?
  responsableId BigInt?        @map("responsable_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at")

  esPersonal     Boolean @default(false) @map("es_personal")
  optOutDifusion Boolean @default(false) @map("opt_out_difusion") // excluido de difusiones masivas
  campos         Json    @default("{}")

  responsable        Usuario?             @relation(fields: [responsableId], references: [id], onDelete: SetNull)
  etiquetas          ContactoEtiqueta[]
  oportunidades      Oportunidad[]
  conversaciones     Conversacion[]
  citas              Cita[]
  expediente         ExpedientePaciente?
  ventas             Venta[]
  expedientesLegales ExpedienteLegal[]
  asesoriasLegales   AsesoriaLegal[]
  movimientosLegales MovimientoLegal[]
  reservasTour       ReservaTour[]
  alumnoAcademia     AlumnoAcademia?
  cuentaCliente      CuentaCliente?
  apartados          Apartado[]
  notasCredito       NotaCreditoCliente[]
  cotizaciones       Cotizacion[]

  @@unique([orgId, telefono])
  @@index([responsableId])
  @@index([orgId])
  @@map("contactos")
}

model Etiqueta {
  id     BigInt @id @default(autoincrement())
  orgId  BigInt @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  nombre String
  color  String @default("#B45309")

  contactos ContactoEtiqueta[]

  @@unique([orgId, nombre])
  @@index([orgId])
  @@map("etiquetas")
}

model ContactoEtiqueta {
  orgId      BigInt @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  contactoId BigInt @map("contacto_id")
  etiquetaId BigInt @map("etiqueta_id")

  contacto Contacto @relation(fields: [contactoId], references: [id], onDelete: Cascade)
  etiqueta Etiqueta @relation(fields: [etiquetaId], references: [id], onDelete: Cascade)

  @@id([contactoId, etiquetaId])
  @@index([orgId])
  @@map("contacto_etiquetas")
}

model Oportunidad {
  id                  BigInt      @id @default(autoincrement())
  orgId               BigInt      @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  contactoId          BigInt      @map("contacto_id")
  embudoId            BigInt      @map("embudo_id")
  etapaId             BigInt      @map("etapa_id")
  titulo              String
  valor               Decimal     @default(0) @db.Decimal(12, 2)
  moneda              String      @default("MXN")
  responsableId       BigInt?     @map("responsable_id")
  orden               Int         @default(0)
  estado              EstadoOport @default(abierto)
  motivoPerdida       String?     @map("motivo_perdida")
  fechaCierreEstimada DateTime?   @map("fecha_cierre_estimada") @db.Date
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @default(now()) @updatedAt @map("updated_at")
  closedAt            DateTime?   @map("closed_at")
  campos              Json        @default("{}")

  contacto     Contacto     @relation(fields: [contactoId], references: [id], onDelete: Cascade)
  embudo       Embudo       @relation(fields: [embudoId], references: [id], onDelete: Cascade)
  etapa        Etapa        @relation(fields: [etapaId], references: [id], onDelete: Restrict)
  responsable  Usuario?     @relation(fields: [responsableId], references: [id], onDelete: SetNull)
  notas        Nota[]
  tareas       Tarea[]
  eventos      Evento[]
  cotizaciones Cotizacion[]

  @@index([etapaId, orden])
  @@index([embudoId])
  @@index([contactoId])
  @@index([orgId])
  @@map("oportunidades")
}

model CanalWhatsapp {
  id        BigInt         @id @default(autoincrement())
  orgId     BigInt         @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  nombre    String
  proveedor ProveedorCanal @default(cloud_api)
  telefono  String?
  instancia String?
  estado    EstadoCanal    @default(desconectado)
  config    Json           @default("{}")
  activo    Boolean        @default(true)
  createdAt DateTime       @default(now()) @map("created_at")

  conversaciones Conversacion[]
  bots           Bot[]
  grupos         Grupo[]

  @@index([orgId])
  @@map("canales_whatsapp")
}

// Grupos de WhatsApp: bandeja aparte, NO son leads (no entran al embudo/CSAT/contactos).
model Grupo {
  id              BigInt    @id @default(autoincrement())
  orgId           BigInt    @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  canalId         BigInt?   @map("canal_id")
  jid             String
  nombre          String
  noLeidos        Int       @default(0) @map("no_leidos")
  ultimoMensajeAt DateTime? @map("ultimo_mensaje_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  canal    CanalWhatsapp? @relation(fields: [canalId], references: [id], onDelete: SetNull)
  mensajes MensajeGrupo[]

  @@unique([orgId, jid])
  @@index([orgId])
  @@map("grupos")
}

model MensajeGrupo {
  id           BigInt       @id @default(autoincrement())
  orgId        BigInt       @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  grupoId      BigInt       @map("grupo_id")
  direccion    DireccionMsg
  tipo         TipoMsg      @default(texto)
  contenido    String?
  mediaUrl     String?      @map("media_url")
  mediaMime    String?      @map("media_mime")
  remitente    String? // nombre de quien escribió en el grupo
  remitenteTel String?      @map("remitente_tel")
  status       StatusMsg    @default(enviado)
  waMessageId  String?      @unique @map("wa_message_id")
  enviadoPor   BigInt?      @map("enviado_por")
  timestamp    DateTime     @default(now())
  createdAt    DateTime     @default(now()) @map("created_at")

  grupo Grupo @relation(fields: [grupoId], references: [id], onDelete: Cascade)

  @@index([grupoId, timestamp])
  @@index([orgId])
  @@map("mensajes_grupo")
}

// Bot nativo: webhook saliente (CRM->n8n) + token para responder (n8n->CRM).
model Bot {
  id         BigInt   @id @default(autoincrement())
  orgId      BigInt   @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  nombre     String
  webhookUrl String   @map("webhook_url") // n8n: el CRM le manda los mensajes entrantes
  apiToken   String   @unique @map("api_token") // n8n: autentica de vuelta con header api_access_token
  canalId    BigInt?  @map("canal_id") // null = aplica a todos los canales
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  canal CanalWhatsapp? @relation(fields: [canalId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@map("bots")
}

model Conversacion {
  id              BigInt     @id @default(autoincrement())
  orgId           BigInt     @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  contactoId      BigInt     @map("contacto_id")
  canalId         BigInt?    @map("canal_id")
  estado          EstadoConv @default(abierta)
  responsableId   BigInt?    @map("responsable_id")
  noLeidos        Int        @default(0) @map("no_leidos")
  botActivo       Boolean    @default(true) @map("bot_activo")
  etiquetas       String[]   @default([])
  csatScore       Int?       @map("csat_score")
  csatEnviadoAt   DateTime?  @map("csat_enviado_at")
  avisoFueraAt    DateTime?  @map("aviso_fuera_at")
  ultimoMensajeAt DateTime?  @map("ultimo_mensaje_at")
  /// Chat fijado (va primero en la bandeja). Null = no fijado.
  fijadoAt        DateTime?  @map("fijado_at")
  createdAt       DateTime   @default(now()) @map("created_at")

  contacto    Contacto            @relation(fields: [contactoId], references: [id], onDelete: Cascade)
  canal       CanalWhatsapp?      @relation(fields: [canalId], references: [id], onDelete: SetNull)
  responsable Usuario?            @relation(fields: [responsableId], references: [id], onDelete: SetNull)
  mensajes    Mensaje[]
  programados MensajeProgramado[]
  citas       Cita[]

  @@unique([contactoId, canalId])
  @@index([ultimoMensajeAt])
  @@index([orgId])
  @@map("conversaciones")
}

/// Mensajes de WhatsApp programados para enviarse después (los dispara el cron).
model MensajeProgramado {
  id             BigInt   @id @default(autoincrement())
  orgId          BigInt   @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  conversacionId BigInt   @map("conversacion_id")
  contenido      String
  enviarAt       DateTime @map("enviar_at")
  estado         String   @default("pendiente") // pendiente | enviado | fallido | cancelado
  creadoPor      BigInt?  @map("creado_por")
  createdAt      DateTime @default(now()) @map("created_at")

  conversacion Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)

  @@index([estado, enviarAt])
  @@index([orgId])
  @@map("mensajes_programados")
}

/// Suscripciones Web Push (una por navegador/dispositivo de cada usuario).
model PushSuscripcion {
  id        BigInt   @id @default(autoincrement())
  orgId     BigInt   @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  usuarioId BigInt?  @map("usuario_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orgId])
  @@map("push_suscripciones")
}

model Mensaje {
  id             BigInt       @id @default(autoincrement())
  orgId          BigInt       @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  conversacionId BigInt       @map("conversacion_id")
  direccion      DireccionMsg
  tipo           TipoMsg      @default(texto)
  contenido      String?
  mediaUrl       String?      @map("media_url")
  mediaMime      String?      @map("media_mime")
  interna        Boolean      @default(false)
  esDifusion     Boolean      @default(false) @map("es_difusion")
  status         StatusMsg    @default(enviado)
  errorDetalle   String?      @map("error_detalle")
  waMessageId    String?      @unique @map("wa_message_id")
  enviadoPor     BigInt?      @map("enviado_por")
  timestamp      DateTime     @default(now())
  createdAt      DateTime     @default(now()) @map("created_at")

  conversacion Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  usuario      Usuario?     @relation(fields: [enviadoPor], references: [id], onDelete: SetNull)

  @@index([conversacionId, timestamp])
  @@index([orgId])
  @@map("mensajes")
}

model PlantillaMensaje {
  id        BigInt   @id @default(autoincrement())
  orgId     BigInt   @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  nombre    String
  contenido String
  categoria String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orgId])
  @@map("plantillas_mensaje")
}

model Nota {
  id            BigInt   @id @default(autoincrement())
  orgId         BigInt   @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  oportunidadId BigInt   @map("oportunidad_id")
  usuarioId     BigInt?  @map("usuario_id")
  contenido     String
  createdAt     DateTime @default(now()) @map("created_at")

  oportunidad Oportunidad @relation(fields: [oportunidadId], references: [id], onDelete: Cascade)
  usuario     Usuario?    @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@map("notas")
}

model Tarea {
  id            BigInt    @id @default(autoincrement())
  orgId         BigInt    @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  oportunidadId BigInt?   @map("oportunidad_id")
  responsableId BigInt?   @map("responsable_id")
  titulo        String
  descripcion   String?
  venceAt       DateTime? @map("vence_at")
  completada    Boolean   @default(false)
  completadaAt  DateTime? @map("completada_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  oportunidad Oportunidad? @relation(fields: [oportunidadId], references: [id], onDelete: Cascade)
  responsable Usuario?     @relation(fields: [responsableId], references: [id], onDelete: SetNull)

  @@index([responsableId, venceAt])
  @@index([orgId])
  @@map("tareas")
}

// Una fila de ajustes POR org (ya no es única global).
model Ajustes {
  id                 BigInt   @id @default(autoincrement())
  orgId              BigInt   @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  autoAsignar        Boolean  @default(false) @map("auto_asignar")
  bienvenidaActiva   Boolean  @default(false) @map("bienvenida_activa")
  bienvenidaTexto    String?  @map("bienvenida_texto")
  crearLeadAuto      Boolean  @default(true) @map("crear_lead_auto")
  // CSAT
  csatActivo         Boolean  @default(false) @map("csat_activo")
  csatTexto          String?  @map("csat_texto")
  // Horario de atención
  horarioActivo      Boolean  @default(false) @map("horario_activo")
  horarioInicio      String?  @map("horario_inicio") // "09:00"
  horarioFin         String?  @map("horario_fin") // "18:00"
  horarioDias        String?  @map("horario_dias") // "1,2,3,4,5" (1=lunes)
  fueraHorarioTexto  String?  @map("fuera_horario_texto")
  // Auto-resolver
  autoResolverActivo Boolean  @default(false) @map("auto_resolver_activo")
  autoResolverHoras  Int      @default(24) @map("auto_resolver_horas")
  // IA
  nombreNegocio      String?  @map("nombre_negocio")
  iaPromptSistema    String?  @map("ia_prompt_sistema")
  marcaNombre        String?  @map("marca_nombre")
  marcaLogo          String?  @map("marca_logo")
  marcaColorPrimario String?  @map("marca_color_primario")
  marcaColorAcento   String?  @map("marca_color_acento")
  marcaPreset        String?  @map("marca_preset")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([orgId])
  @@map("ajustes")
}

model ModuloOrg {
  id        BigInt   @id @default(autoincrement())
  orgId     BigInt   @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  clave     String
  activo    Boolean  @default(false)
  config    Json     @default("{}")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([orgId, clave])
  @@index([orgId])
  @@map("modulos_org")
}

model CampoPersonalizado {
  id          BigInt                    @id @default(autoincrement())
  orgId       BigInt                    @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  entidad     EntidadCampoPersonalizado
  clave       String
  etiqueta    String
  tipo        TipoCampoPersonalizado
  opciones    Json                      @default("[]")
  obligatorio Boolean                   @default(false)
  orden       Int                       @default(0)
  activo      Boolean                   @default(true)

  @@unique([orgId, entidad, clave])
  @@index([orgId, entidad, orden])
  @@map("campos_personalizados")
}

model Cita {
  id                    BigInt     @id @default(autoincrement())
  orgId                 BigInt     @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  contactoId            BigInt     @map("contacto_id")
  conversacionId        BigInt?    @map("conversacion_id")
  responsableId         BigInt?    @map("responsable_id")
  doctorId              BigInt?    @map("doctor_id")
  inicio                DateTime
  fin                   DateTime
  titulo                String
  notas                 String?
  estado                EstadoCita @default(programada)
  recordatorioEnviadoAt DateTime?  @map("recordatorio_enviado_at")
  servicioId            BigInt?    @map("servicio_id")
  tokenGestion          String?    @unique @map("token_gestion")
  origen                String     @default("interna")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @default(now()) @updatedAt @map("updated_at")

  contacto     Contacto           @relation(fields: [contactoId], references: [id], onDelete: Cascade)
  conversacion Conversacion?      @relation(fields: [conversacionId], references: [id], onDelete: SetNull)
  responsable  Usuario?           @relation(fields: [responsableId], references: [id], onDelete: SetNull)
  doctor       Doctor?            @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  servicio     ServicioReserva?   @relation(fields: [servicioId], references: [id], onDelete: SetNull)
  evoluciones  EvolucionClinica[]

  @@index([orgId, inicio])
  @@index([contactoId])
  @@index([doctorId])
  @@map("citas")
}

model Doctor {
  id           BigInt   @id @default(autoincrement())
  orgId        BigInt   @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  nombre       String
  especialidad String?
  cedula       String?
  color        String   @default("#0EA5E9")
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  citas       Cita[]
  evoluciones EvolucionClinica[]
  servicios   ServicioReservaDoctor[]
  horarios    HorarioDoctor[]
  excepciones ExcepcionHorario[]

  @@unique([orgId, nombre])
  @@index([orgId, activo])
  @@map("doctores")
}

model ExpedientePaciente {
  id              BigInt    @id @default(autoincrement())
  orgId           BigInt    @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  contactoId      BigInt    @unique @map("contacto_id")
  fechaNacimiento DateTime? @map("fecha_nacimiento") @db.Date
  sexo            String?
  alergias        String?
  antecedentes    String?
  medicamentos    String?
  observaciones   String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  contacto    Contacto           @relation(fields: [contactoId], references: [id], onDelete: Cascade)
  evoluciones EvolucionClinica[]

  @@index([orgId])
  @@map("expedientes_paciente")
}

model EvolucionClinica {
  id              BigInt   @id @default(autoincrement())
  orgId           BigInt   @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  expedienteId    BigInt   @map("expediente_id")
  citaId          BigInt?  @map("cita_id")
  doctorId        BigInt?  @map("doctor_id")
  registradoPorId BigInt?  @map("registrado_por_id")
  contenido       String
  createdAt       DateTime @default(now()) @map("created_at")

  expediente    ExpedientePaciente @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  cita          Cita?              @relation(fields: [citaId], references: [id], onDelete: SetNull)
  doctor        Doctor?            @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  registradoPor Usuario?           @relation(fields: [registradoPorId], references: [id], onDelete: SetNull)

  @@index([expedienteId, createdAt])
  @@index([orgId])
  @@map("evoluciones_clinicas")
}

model Vehiculo {
  id          BigInt         @id @default(autoincrement())
  orgId       BigInt         @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  numeroStock String?        @map("numero_stock")
  vin         String?
  marca       String
  modelo      String
  anio        Int
  version     String?
  color       String?
  kilometraje Int            @default(0)
  precio      Decimal        @default(0) @db.Decimal(12, 2)
  moneda      String         @default("MXN")
  estado      EstadoVehiculo @default(disponible)
  fotoUrl     String?        @map("foto_url")
  notas       String?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at")

  @@unique([orgId, numeroStock])
  @@unique([orgId, vin])
  @@index([orgId, estado])
  @@index([orgId, marca, modelo])
  @@map("vehiculos")
}

model Propiedad {
  id         BigInt   @id @default(autoincrement())
  orgId      BigInt   @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  clave      String?
  titulo     String
  tipo       String
  operacion  String
  direccion  String?
  colonia    String?
  ciudad     String
  recamaras  Int      @default(0)
  banos      Decimal  @default(0) @db.Decimal(4, 1)
  superficie Decimal  @default(0) @db.Decimal(10, 2)
  precio     Decimal  @default(0) @db.Decimal(14, 2)
  moneda     String   @default("MXN")
  estado     String   @default("disponible")
  fotoUrl    String?  @map("foto_url")
  notas      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([orgId, clave])
  @@index([orgId, estado])
  @@index([orgId, ciudad, tipo])
  @@map("propiedades")
}

model Producto {
  id           BigInt   @id @default(autoincrement())
  orgId        BigInt   @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  sku          String?
  codigoBarras String?  @map("codigo_barras")
  nombre       String
  categoria    String?
  descripcion  String?
  precio       Decimal  @default(0) @db.Decimal(12, 2)
  costo        Decimal  @default(0) @db.Decimal(12, 2)
  stock        Decimal  @default(0) @db.Decimal(12, 3)
  stockMinimo  Decimal  @default(0) @map("stock_minimo") @db.Decimal(12, 3)
  unidad       String   @default("pieza")
  vendePorPeso Boolean  @default(false) @map("vende_por_peso")
  moneda       String   @default("MXN")
  fotoUrl      String?  @map("foto_url")
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  movimientos  MovimientoInventario[]
  partidas     VentaPartida[]
  compras      CompraPartida[]
  cotizaciones CotizacionPartida[]

  @@unique([orgId, sku])
  @@unique([orgId, codigoBarras])
  @@index([orgId, activo, nombre])
  @@index([orgId, categoria])
  @@map("productos")
}

model Venta {
  id            BigInt   @id @default(autoincrement())
  orgId         BigInt   @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  folio         String
  contactoId    BigInt?  @map("contacto_id")
  creadoPorId   BigInt?  @map("creado_por_id")
  turnoId       BigInt?  @map("turno_id")
  cajaId        BigInt?  @map("caja_id")
  uuidCliente   String?  @map("uuid_cliente")
  estado        String   @default("pendiente")
  canal         String   @default("mostrador")
  metodoPago    String?  @map("metodo_pago")
  subtotal      Decimal  @default(0) @db.Decimal(12, 2)
  descuento     Decimal  @default(0) @db.Decimal(12, 2)
  total         Decimal  @default(0) @db.Decimal(12, 2)
  cambio        Decimal  @default(0) @db.Decimal(12, 2)
  moneda        String   @default("MXN")
  notas         String?
  stockAplicado Boolean  @default(false) @map("stock_aplicado")
  esCredito     Boolean  @default(false) @map("es_credito")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  contacto               Contacto?                 @relation(fields: [contactoId], references: [id], onDelete: SetNull)
  creadoPor              Usuario?                  @relation("VentaCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)
  turno                  TurnoCaja?                @relation(fields: [turnoId], references: [id], onDelete: SetNull)
  caja                   Caja?                     @relation(fields: [cajaId], references: [id], onDelete: SetNull)
  partidas               VentaPartida[]
  pagos                  PagoVenta[]
  movimientos            MovimientoInventario[]
  devolucionesOriginales DevolucionVenta[]         @relation("VentaOriginal")
  devolucionesCambio     DevolucionVenta[]         @relation("VentaCambio")
  apartado               Apartado?
  movimientosCuenta      MovimientoCuentaCliente[]
  cotizacion             Cotizacion?

  @@unique([orgId, folio])
  @@unique([orgId, uuidCliente])
  @@index([orgId, estado, createdAt])
  @@index([contactoId])
  @@index([turnoId])
  @@index([cajaId])
  @@map("ventas")
}

model VentaPartida {
  id             BigInt  @id @default(autoincrement())
  orgId          BigInt  @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  ventaId        BigInt  @map("venta_id")
  productoId     BigInt  @map("producto_id")
  cantidad       Decimal @db.Decimal(12, 3)
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(12, 2)
  descuento      Decimal @default(0) @db.Decimal(12, 2)
  total          Decimal @db.Decimal(12, 2)

  venta        Venta               @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  producto     Producto            @relation(fields: [productoId], references: [id], onDelete: Restrict)
  devoluciones DevolucionPartida[]

  @@index([ventaId])
  @@index([productoId])
  @@index([orgId])
  @@map("venta_partidas")
}

model Caja {
  id        BigInt   @id @default(autoincrement())
  orgId     BigInt   @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  nombre    String
  sucursal  String?
  activa    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  turnos TurnoCaja[]
  ventas Venta[]

  @@unique([orgId, nombre])
  @@index([orgId, activa])
  @@map("cajas")
}

model TurnoCaja {
  id               BigInt    @id @default(autoincrement())
  orgId            BigInt    @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  cajaId           BigInt    @map("caja_id")
  usuarioId        BigInt    @map("usuario_id")
  fondoInicial     Decimal   @default(0) @map("fondo_inicial") @db.Decimal(12, 2)
  abiertoAt        DateTime  @default(now()) @map("abierto_at")
  cerradoAt        DateTime? @map("cerrado_at")
  efectivoContado  Decimal?  @map("efectivo_contado") @db.Decimal(12, 2)
  efectivoEsperado Decimal?  @map("efectivo_esperado") @db.Decimal(12, 2)
  diferencia       Decimal?  @db.Decimal(12, 2)
  estado           String    @default("abierto")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  caja              Caja                      @relation(fields: [cajaId], references: [id], onDelete: Restrict)
  usuario           Usuario                   @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  movimientos       MovimientoCaja[]
  ventas            Venta[]
  devoluciones      DevolucionVenta[]
  abonosApartado    AbonoApartado[]
  movimientosCuenta MovimientoCuentaCliente[]

  @@index([orgId, estado])
  @@index([cajaId, estado])
  @@index([usuarioId, estado])
  @@map("turnos_caja")
}

model MovimientoCaja {
  id        BigInt   @id @default(autoincrement())
  orgId     BigInt   @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  turnoId   BigInt   @map("turno_id")
  tipo      String
  monto     Decimal  @db.Decimal(12, 2)
  motivo    String
  usuarioId BigInt?  @map("usuario_id")
  createdAt DateTime @default(now()) @map("created_at")

  turno   TurnoCaja @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  usuario Usuario?  @relation("MovimientoCajaUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([turnoId, createdAt])
  @@index([orgId])
  @@map("movimientos_caja")
}

model PagoVenta {
  id        BigInt   @id @default(autoincrement())
  orgId     BigInt   @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  ventaId   BigInt   @map("venta_id")
  metodo    String
  monto     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")

  venta Venta @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  @@unique([ventaId, metodo])
  @@index([orgId])
  @@map("pagos_venta")
}

model DevolucionVenta {
  id              BigInt   @id @default(autoincrement())
  orgId           BigInt   @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  ventaOriginalId BigInt   @map("venta_original_id")
  ventaCambioId   BigInt?  @map("venta_cambio_id")
  turnoId         BigInt?  @map("turno_id")
  usuarioId       BigInt?  @map("usuario_id")
  tipoReembolso   String   @map("tipo_reembolso")
  total           Decimal  @db.Decimal(12, 2)
  motivo          String?
  createdAt       DateTime @default(now()) @map("created_at")

  ventaOriginal Venta               @relation("VentaOriginal", fields: [ventaOriginalId], references: [id], onDelete: Restrict)
  ventaCambio   Venta?              @relation("VentaCambio", fields: [ventaCambioId], references: [id], onDelete: SetNull)
  turno         TurnoCaja?          @relation(fields: [turnoId], references: [id], onDelete: SetNull)
  usuario       Usuario?            @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  partidas      DevolucionPartida[]
  notaCredito   NotaCreditoCliente?

  @@index([ventaOriginalId, createdAt])
  @@index([orgId])
  @@map("devoluciones_venta")
}

model DevolucionPartida {
  id             BigInt  @id @default(autoincrement())
  orgId          BigInt  @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  devolucionId   BigInt  @map("devolucion_id")
  ventaPartidaId BigInt  @map("venta_partida_id")
  cantidad       Decimal @db.Decimal(12, 3)
  monto          Decimal @db.Decimal(12, 2)

  devolucion   DevolucionVenta @relation(fields: [devolucionId], references: [id], onDelete: Cascade)
  ventaPartida VentaPartida    @relation(fields: [ventaPartidaId], references: [id], onDelete: Restrict)

  @@unique([devolucionId, ventaPartidaId])
  @@index([ventaPartidaId])
  @@index([orgId])
  @@map("devolucion_partidas")
}

model Apartado {
  id          BigInt    @id @default(autoincrement())
  orgId       BigInt    @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  ventaId     BigInt    @unique @map("venta_id")
  contactoId  BigInt    @map("contacto_id")
  usuarioId   BigInt?   @map("usuario_id")
  estado      String    @default("activo")
  anticipo    Decimal   @db.Decimal(12, 2)
  saldo       Decimal   @db.Decimal(12, 2)
  venceAt     DateTime  @map("vence_at")
  liquidadoAt DateTime? @map("liquidado_at")
  canceladoAt DateTime? @map("cancelado_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  venta        Venta                @relation(fields: [ventaId], references: [id], onDelete: Restrict)
  contacto     Contacto             @relation(fields: [contactoId], references: [id], onDelete: Restrict)
  usuario      Usuario?             @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  abonos       AbonoApartado[]
  notasCredito NotaCreditoCliente[]

  @@index([orgId, estado, venceAt])
  @@index([contactoId])
  @@map("apartados")
}

model AbonoApartado {
  id         BigInt   @id @default(autoincrement())
  orgId      BigInt   @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  apartadoId BigInt   @map("apartado_id")
  turnoId    BigInt?  @map("turno_id")
  usuarioId  BigInt?  @map("usuario_id")
  metodo     String
  monto      Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at")

  apartado Apartado   @relation(fields: [apartadoId], references: [id], onDelete: Cascade)
  turno    TurnoCaja? @relation(fields: [turnoId], references: [id], onDelete: SetNull)
  usuario  Usuario?   @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([apartadoId, createdAt])
  @@index([orgId])
  @@map("abonos_apartado")
}

model CuentaCliente {
  id            BigInt   @id @default(autoincrement())
  orgId         BigInt   @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  contactoId    BigInt   @unique @map("contacto_id")
  limiteCredito Decimal  @default(0) @map("limite_credito") @db.Decimal(12, 2)
  saldo         Decimal  @default(0) @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  contacto    Contacto                  @relation(fields: [contactoId], references: [id], onDelete: Restrict)
  movimientos MovimientoCuentaCliente[]

  @@index([orgId])
  @@map("cuentas_cliente")
}

model MovimientoCuentaCliente {
  id           BigInt   @id @default(autoincrement())
  orgId        BigInt   @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  cuentaId     BigInt   @map("cuenta_id")
  ventaId      BigInt?  @map("venta_id")
  turnoId      BigInt?  @map("turno_id")
  usuarioId    BigInt?  @map("usuario_id")
  tipo         String
  monto        Decimal  @db.Decimal(12, 2)
  saldoAntes   Decimal  @map("saldo_antes") @db.Decimal(12, 2)
  saldoDespues Decimal  @map("saldo_despues") @db.Decimal(12, 2)
  referencia   String?
  createdAt    DateTime @default(now()) @map("created_at")

  cuenta  CuentaCliente @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  venta   Venta?        @relation(fields: [ventaId], references: [id], onDelete: SetNull)
  turno   TurnoCaja?    @relation(fields: [turnoId], references: [id], onDelete: SetNull)
  usuario Usuario?      @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([cuentaId, createdAt])
  @@index([orgId])
  @@map("movimientos_cuenta_cliente")
}

model NotaCreditoCliente {
  id            BigInt   @id @default(autoincrement())
  orgId         BigInt   @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  contactoId    BigInt   @map("contacto_id")
  devolucionId  BigInt?  @unique @map("devolucion_id")
  apartadoId    BigInt?  @map("apartado_id")
  montoOriginal Decimal  @map("monto_original") @db.Decimal(12, 2)
  saldo         Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  contacto   Contacto         @relation(fields: [contactoId], references: [id], onDelete: Restrict)
  devolucion DevolucionVenta? @relation(fields: [devolucionId], references: [id], onDelete: Restrict)
  apartado   Apartado?        @relation(fields: [apartadoId], references: [id], onDelete: Restrict)

  @@index([contactoId, createdAt])
  @@index([orgId])
  @@map("notas_credito_cliente")
}

model Cotizacion {
  id             BigInt    @id @default(autoincrement())
  orgId          BigInt    @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  folio          String
  contactoId     BigInt    @map("contacto_id")
  oportunidadId  BigInt?   @map("oportunidad_id")
  ventaId        BigInt?   @unique @map("venta_id")
  creadoPorId    BigInt?   @map("creado_por_id")
  estado         String    @default("borrador")
  vigencia       DateTime  @db.Date
  notas          String?
  condiciones    String?
  subtotal       Decimal   @db.Decimal(12, 2)
  descuento      Decimal   @default(0) @db.Decimal(12, 2)
  impuestos      Decimal   @default(0) @db.Decimal(12, 2)
  total          Decimal   @db.Decimal(12, 2)
  ivaPorcentaje  Decimal   @default(16) @map("iva_porcentaje") @db.Decimal(5, 2)
  preciosConIva  Boolean   @default(false) @map("precios_con_iva")
  tokenPublico   String    @unique @map("token_publico")
  version        Int       @default(1)
  convertirVenta Boolean   @default(false) @map("convertir_venta")
  respondidoPor  String?   @map("respondido_por")
  respondidoAt   DateTime? @map("respondido_at")
  respondidoIp   String?   @map("respondido_ip")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  contacto    Contacto            @relation(fields: [contactoId], references: [id], onDelete: Restrict)
  oportunidad Oportunidad?        @relation(fields: [oportunidadId], references: [id], onDelete: SetNull)
  venta       Venta?              @relation(fields: [ventaId], references: [id], onDelete: SetNull)
  creadoPor   Usuario?            @relation("CotizacionCreadaPor", fields: [creadoPorId], references: [id], onDelete: SetNull)
  partidas    CotizacionPartida[]

  @@unique([orgId, folio])
  @@index([orgId, estado, createdAt])
  @@index([contactoId])
  @@index([oportunidadId])
  @@map("cotizaciones")
}

model CotizacionPartida {
  id           BigInt  @id @default(autoincrement())
  orgId        BigInt  @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  cotizacionId BigInt  @map("cotizacion_id")
  productoId   BigInt? @map("producto_id")
  concepto     String
  cantidad     Decimal @db.Decimal(12, 3)
  precio       Decimal @db.Decimal(12, 2)
  descuento    Decimal @default(0) @db.Decimal(12, 2)
  total        Decimal @db.Decimal(12, 2)

  cotizacion Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  producto   Producto?  @relation(fields: [productoId], references: [id], onDelete: SetNull)

  @@index([cotizacionId])
  @@index([productoId])
  @@index([orgId])
  @@map("cotizacion_partidas")
}

model Proveedor {
  id             BigInt   @id @default(autoincrement())
  orgId          BigInt   @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  nombre         String
  contactoNombre String?  @map("contacto_nombre")
  telefono       String?
  email          String?
  rfc            String?
  notas          String?
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  compras Compra[]

  @@unique([orgId, nombre])
  @@index([orgId, activo])
  @@map("proveedores")
}

model Compra {
  id            BigInt   @id @default(autoincrement())
  orgId         BigInt   @default(dbgenerated("NULLIF(current_setting('app.current_org', true), '')::bigint")) @map("org_id")
  folio         String
  proveedorId   BigInt   @map("proveedor_id")
  creadoPorId   BigInt?  @map("creado_por_id")
  estado        String   @default("ordenada")
  total         Decimal  @default(0) @db.Decimal(12, 2)
  moneda        String   @default("MXN")
  notas         String?
  stockAplicado Boolean  @default(false) @map("stock_aplicado")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  proveedor   Proveedor              @relation(fields: [proveedorId], references: [id], onDelete: Restrict)
