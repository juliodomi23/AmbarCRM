# ---- Base de datos ----
# MULTI-TENANT: usa el rol crm_app (sin BYPASSRLS), no el dueño/superusuario.
DATABASE_URL="postgresql://crm_app:CAMBIAME@localhost:5432/ambarcrm?schema=public"

# ---- Auth.js / NextAuth ----
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="genera-un-secreto-largo"

# ---- Recuperación de contraseña por correo (opcional; requiere todos los campos) ----
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="AmbarCRM <no-reply@ambarrojostudios.cloud>"

# ---- Multi-tenant ----
DEFAULT_ORG_SLUG="inicial"
# BASE_DOMAIN_FIRST_LABEL="www"

# ---- Integraciones internas de n8n ----
WA_API_KEY="genera-una-clave-larga"

# ---- Meta Tech Provider: Cloud API + Embedded Signup v4 + Coexistence ----
META_APP_ID=""
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN=""
META_GRAPH_VERSION="v26.0"
META_HUMAN_AGENT_APROBADO="false"
# Verificación de webhooks de Messenger e Instagram; el mismo valor va en el panel de Meta.
MESSENGER_VERIFY_TOKEN=""
# IDs de organización (separados por coma) que ven Messenger e Instagram en Configuración. Vacío = nadie. Úsalo solo para la org del revisor de Meta.
META_CANALES_REVISION_ORGS=""
# Opcional: config_id de Facebook Login para empresas (tipo "User access token") para Messenger e Instagram. Vacío = el diálogo usa scope.
META_MESSENGER_CONFIG_ID=""
META_INSTAGRAM_CONFIG_ID=""
# Debe ser exactamente una clave aleatoria de 32 bytes codificada en Base64.
META_TOKEN_ENCRYPTION_KEY=""

NEXT_PUBLIC_META_APP_ID=""
NEXT_PUBLIC_META_CONFIG_ID=""
NEXT_PUBLIC_META_GRAPH_VERSION="v26.0"

# ---- Páginas legales ----
LEGAL_BUSINESS_NAME="Nombre legal de la empresa"
PRIVACY_EMAIL="privacidad@tudominio.com"

# ---- Notificaciones push (opcional) ----
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""

# Lealtad (Aurum). URL fija del servidor de tarjetas y secreto del webhook de Aurum.
# Preferido: header `x-aurum-clave: <AURUM_WEBHOOK_SECRET>` hacia https://<crm>/api/public/aurum/webhook
# Compatible (queda en logs de proxies): https://<crm>/api/public/aurum/webhook?clave=<AURUM_WEBHOOK_SECRET>
AURUM_URL="https://lealtad.ambarrojostudios.cloud"
AURUM_WEBHOOK_SECRET=""

# API del bot (/api/v1): peticiones permitidas por token y ventana
BOT_RATE_LIMIT_MAX=300
BOT_RATE_LIMIT_WINDOW_MS=60000

# Intentos con token inválido por IP (devuelve 429 al pasar el tope)
BOT_AUTH_FAIL_MAX=20
BOT_AUTH_FAIL_WINDOW_MS=300000
